# Runtime
ASPNETCORE_ENVIRONMENT=Development

# Local dependency credentials and connection strings
POSTGRES_DB=vistora
POSTGRES_USER=vistora
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=vistora
RABBITMQ_DEFAULT_PASS=change-me

# Future application integrations
VISTORA_POSTGRES_CONNECTION=Host=postgres;Port=5432;Database=vistora;Username=vistora;Password=change-me
VISTORA_REDIS_CONNECTION=redis:6379
VISTORA_RABBITMQ_CONNECTION=amqp://vistora:change-me@rabbitmq:5672/
VISTORA_RABBITMQ_QUEUE=vistora.messages
# Supabase Storage S3 API. Generate server-only S3 keys in Supabase Storage settings.
VISTORA_STORAGE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
VISTORA_STORAGE_S3_REGION=your-project-region
VISTORA_STORAGE_S3_BUCKET=vistora-private
VISTORA_STORAGE_S3_ACCESS_KEY_ID=
VISTORA_STORAGE_S3_SECRET_ACCESS_KEY=
VISTORA_AUTHORITY=
VISTORA_AUTH_AUDIENCE=
