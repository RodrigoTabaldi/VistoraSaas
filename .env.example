# Runtime
ASPNETCORE_ENVIRONMENT=Development

# Local dependency credentials and connection strings
POSTGRES_DB=vistora
POSTGRES_USER=vistora
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=vistora
RABBITMQ_DEFAULT_PASS=change-me

# Future application integrations
VISTORA_POSTGRES_CONNECTION=Host=postgres;Port=5432;Database=vistora;Username=vistora_app;Password=change-me
VISTORA_POSTGRES_MIGRATION_CONNECTION=Host=postgres;Port=5432;Database=vistora;Username=vistora;Password=change-me
VISTORA_REDIS_CONNECTION=redis:6379
VISTORA_RABBITMQ_CONNECTION=amqp://vistora:change-me@rabbitmq:5672/
VISTORA_RABBITMQ_QUEUE=vistora.messages
# Local MinIO defaults. For production, use a private HTTPS S3 endpoint and server-only credentials.
VISTORA_STORAGE_S3_ENDPOINT=http://minio:9000
VISTORA_STORAGE_S3_REGION=us-east-1
VISTORA_STORAGE_S3_BUCKET=vistora-private
VISTORA_STORAGE_S3_ACCESS_KEY_ID=minioadmin
VISTORA_STORAGE_S3_SECRET_ACCESS_KEY=minioadmin123
VISTORA_S3_ALLOW_INSECURE_LOCAL=true
VISTORA_AUTHORITY=
VISTORA_AUTH_AUDIENCE=
